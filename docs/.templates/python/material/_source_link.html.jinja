{#-
  Link from a documented object to its definition on GitHub (#1015).

  mkdocstrings-python has no built-in "view source on GitHub" link, only the
  inline ``show_source`` block. This macro builds the link from the file path
  and line range Griffe already knows, plus ``extra.source_url_base`` from
  zensical.toml (``https://github.com/<owner>/<repo>/blob/<branch>``).

  Used by the ``source`` block overrides in class/function/module templates.
-#}
{% macro source_link(obj, config) %}
  {%- set base = config.extra.get("source_url_base") -%}
  {%- if base -%}
    {%- set path = (obj|source_location).as_posix() -%}
    {%- if obj.lineno -%}
      {%- set anchor = "#L" ~ obj.lineno ~ "-L" ~ (obj.endlineno or obj.lineno) -%}
      {%- set label = path ~ ":" ~ obj.lineno -%}
    {%- else -%}
      {%- set anchor = "" -%}
      {%- set label = path -%}
    {%- endif -%}
    <p class="doc-source-link">
      <a href="{{ base }}/{{ path }}{{ anchor }}" target="_blank" rel="noopener" title="Open the definition on GitHub">View source on GitHub</a>
      <code>{{ label }}</code>
    </p>
  {%- endif -%}
{% endmacro %}
